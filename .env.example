# Supabase (Project Settings → API). Sin estas dos, la app corre en modo demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor (webhooks ONVO, tareas admin). Nunca con prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# 1 = el registro exige confirmar el correo (actívalo cuando Supabase Auth ya envíe correos con SMTP propio, p. ej. Resend).
# Vacío = cuentas confirmadas al registrarse (sin correo), como hasta ahora.
AUTH_EMAIL_CONFIRM=
# Producción: https://www.bananaburn.app (dominio canónico; bananaburn.app redirige a www). Sin ella, en Vercel se usa ese mismo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Fase 1–2
ANTHROPIC_API_KEY=          # activa el Coach IA real (sin ella responde en modo demo)
COACH_MODEL=claude-sonnet-5-5
# Pagos · ONVO Pay (ver README → "Pagos (ONVO)"). Sin todas estas, los botones de pago quedan desactivados.
ONVO_SECRET_KEY=                    # onvo_test_secret_key_… / onvo_live_secret_key_… (solo servidor)
NEXT_PUBLIC_ONVO_PUBLISHABLE_KEY=   # onvo_test_publishable_key_… (va al navegador para el SDK de pago)
ONVO_WEBHOOK_SECRET=                # webhook_secret_… (Dashboard → Desarrolladores → Webhooks)
ONVO_PRICE_ENTRENO_MES=             # ID del precio recurrente $9.99/mes
ONVO_PRICE_ENTRENO_ANUAL=           # ID del precio recurrente $59.99/año
ONVO_PRICE_COMPLETO_MES=            # ID del precio recurrente $14.99/mes
ONVO_PRICE_COMPLETO_ANUAL=          # ID del precio recurrente $89.99/año

# Pagos · Tilopay (tarjetas de fuera de Costa Rica; 0042). Sin las cuatro primeras (y TILOPAY_ENABLED=1) todo sigue con ONVO.
# Datos en Tilopay → Admin → Integraciones. Modo prueba/producción se cambia en el portal de Tilopay (mismo host).
TILOPAY_API_USER=                   # usuario de API (solo servidor)
TILOPAY_API_PASSWORD=               # contraseña de API (solo servidor; también firma la vuelta si no hay TILOPAY_STATE_SECRET)
TILOPAY_KEY=                        # llave de integración (solo servidor)
TILOPAY_ENABLED=                    # 1 = para todos; staff = solo cuentas del equipo (pruebas en producción); vacío o 0 = apagado
TILOPAY_REMOVE_CARD_PATH=           # opcional: ruta de "quitar tarjeta" que confirme Tilopay (por defecto /api/v1/removeCard)
TILOPAY_STATE_SECRET=               # opcional: secreto aparte para firmar la vuelta desde Tilopay

# Comunicaciones (todas opcionales: sin ellas los envíos son no-op)
RESEND_API_KEY=             # re_… (Resend → API Keys). Sin ella no se manda ningún correo
EMAIL_FROM="Banana Burn <hola@bananaburn.app>"   # dominio verificado en Resend
EMAIL_UNSUB_SECRET=         # openssl rand -hex 32 · firma los enlaces de baja (HMAC)
FEEDBACK_EMAIL=             # opcional: a dónde llegan los "Reportar algo" de la app (por defecto hola@bananaburn.app)
# Web Push: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=   # pública (va al navegador)
VAPID_PUBLIC_KEY=               # misma pública, para el servidor (opcional si ya está la NEXT_PUBLIC)
VAPID_PRIVATE_KEY=              # privada, solo servidor
VAPID_SUBJECT=mailto:hola@bananaburn.app
# Cron de recordatorios: Vercel manda "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=                # openssl rand -hex 32
NOTIFY_CRON_MODE=daily      # daily (Hobby, 07:00 CR) | hourly (Vercel Pro: cambia también vercel.json a "0 * * * *")
EXERCISE_MEDIA_BASE_URL=          # solo con licencia propia de Gym visual (ver README → Biblioteca)

# Monitoreo (opcional, ver docs/MONITOREO.md). Errores en la tabla app_errors (0041) y aviso diario si se disparan.
OPS_ALERT_EMAIL=            # a quién llega el aviso (por defecto FEEDBACK_EMAIL o hola@bananaburn.app)
OPS_ALERT_THRESHOLD=        # errores en 24 h para avisar (por defecto 50, mínimo 5); también el aviso de Admin > Avisos
# Sentry (opcional): sin DSN queda apagado. Sin SENTRY_AUTH_TOKEN no se generan ni suben mapas de fuente.
NEXT_PUBLIC_SENTRY_DSN=     # DSN del proyecto (Settings → Client Keys). Es público por diseño: solo sirve para mandar eventos
SENTRY_DSN=                 # opcional: otro DSN para el servidor (por defecto usa NEXT_PUBLIC_SENTRY_DSN)
SENTRY_ORG=                 # slug de la organización (para subir mapas de fuente en el build)
SENTRY_PROJECT=             # slug del proyecto
SENTRY_AUTH_TOKEN=          # token de organización con permiso de subir mapas; solo en el build, nunca NEXT_PUBLIC_

# App nativa (Capacitor, docs/app-nativa.md). Todas opcionales: sin ellas la web funciona igual que hoy.
# Universal Links (iPhone): Team ID de 10 caracteres de la cuenta de Apple Developer (Membership). Sin él,
# /.well-known/apple-app-site-association responde 404.
APPLE_TEAM_ID=
# App Links (Android): huellas SHA-256 de los certificados que firman la app, separadas por coma (llave de debug fija,
# llave de subida y la de firma de Google Play). Sin ellas, /.well-known/assetlinks.json responde 404.
ANDROID_CERT_SHA256=
# Login nativo con Google (Google Cloud → Credenciales, mismo proyecto que el proveedor Google de Supabase). No son secretos.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=   # cliente "Aplicación web" (Android y servidor)
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=   # cliente "iOS" con el bundle app.bananaburn
# 1 = "Continuar con Apple" en la app de iPhone (Supabase → Auth → Apple activo con app.bananaburn en Client IDs).
# En iPhone, Google solo aparece si esto está en 1 (regla 4.8 de Apple).
NEXT_PUBLIC_NATIVE_APPLE_AUTH=
# Solo al compilar la app (npm run native:sync), nunca en Vercel: servidor que carga la app. Vacío = www.bananaburn.app.
# CAP_SERVER_URL=https://<url-del-preview>.vercel.app
# Push de la app nativa (0057, src/lib/push-native.ts). Solo servidor. Sin ellas, la app no recibe avisos push.
FCM_SERVICE_ACCOUNT_JSON=     # Firebase → Configuración → Cuentas de servicio → Generar clave privada (el JSON, o el JSON en base64)
APNS_KEY_ID=                  # Apple Developer → Keys → llave con "Apple Push Notifications service" (10 caracteres)
APNS_TEAM_ID=                 # opcional: si falta se usa APPLE_TEAM_ID
APNS_PRIVATE_KEY=             # contenido del archivo .p8 de esa llave (con saltos de línea o con \n)
APNS_ENV=auto                 # production | sandbox | auto (producción y, si el token es de una build de Xcode, sandbox)
# 1 = la app ofrece avisos push (solo cuando las llaves de arriba ya están y el APK trae google-services.json).
NEXT_PUBLIC_NATIVE_PUSH=
